<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Rogarion.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Rogarion.App.Controls"
    xmlns:converters="using:Rogarion.App.Converters">

    <Grid>
        <Grid.Resources>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar (draggable region for ExtendsContentIntoTitleBar) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0">
            <TextBlock Text="Rogarion"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"
                       Opacity="0.8" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar: chat history -->
            <Grid Grid.Column="0" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="History"
                           Margin="16,16,16,8"
                           Style="{ThemeResource SubtitleTextBlockStyle}" />

                <Button Grid.Row="1"
                        Content="New Chat"
                        Margin="8,0,8,8"
                        HorizontalAlignment="Stretch"
                        Click="NewChatButton_Click" />

                <ListView x:Name="SessionListView"
                          Grid.Row="2"
                          Margin="8,0,8,8"
                          SelectionChanged="SessionListView_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding IsGeneratingTitle, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="6"
                                                Visibility="{Binding IsGeneratingTitle, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ProgressRing IsActive="True" Width="12" Height="12" />
                                        <TextBlock Text="Naming…" Opacity="0.7" />
                                    </StackPanel>
                                </Grid>
                                <Button Grid.Column="1"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="6"
                                        Click="RenameSessionButton_Click"
                                        Tag="{Binding}"
                                        ToolTipService.ToolTip="Rename">
                                    <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                </Button>
                                <Button Grid.Column="2"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="6"
                                        Click="DeleteSessionButton_Click"
                                        Tag="{Binding}"
                                        ToolTipService.ToolTip="Delete">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Main chat pane -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Model picker (top bar) -->
                <Grid Grid.Row="0"
                      x:Name="TopBar"
                      Padding="16,12"
                      Visibility="Collapsed">
                    <ComboBox x:Name="ModelPickerComboBox"
                              PlaceholderText="Select a model"
                              MinWidth="220"
                              HorizontalAlignment="Left"
                              SelectionChanged="ModelPickerComboBox_SelectionChanged" />
                </Grid>

                <!-- Checking state -->
                <StackPanel x:Name="CheckingPanel"
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="12">
                    <ProgressRing IsActive="True" Width="32" Height="32" />
                    <TextBlock Text="Checking for Ollama..."
                               Style="{ThemeResource BodyTextBlockStyle}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Unreachable state -->
                <StackPanel x:Name="UnreachablePanel"
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="8"
                            MaxWidth="420"
                            Visibility="Collapsed">
                    <TextBlock Text="Ollama isn't running"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Rogarion couldn't reach Ollama at localhost:11434. See the README for setup instructions: install Ollama, pull a model, and make sure it's running."
                               Style="{ThemeResource BodyTextBlockStyle}"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </StackPanel>

                <!-- No models state -->
                <StackPanel x:Name="NoModelsPanel"
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="8"
                            MaxWidth="420"
                            Visibility="Collapsed">
                    <TextBlock Text="No models installed"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Ollama is running, but no models are installed. Pull one from a terminal, e.g. 'ollama pull qwen2.5-coder:7b', then restart Rogarion. See the README for details."
                               Style="{ThemeResource BodyTextBlockStyle}"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </StackPanel>

                <!-- Empty state (ready, no conversation yet) -->
                <StackPanel x:Name="EmptyStatePanel"
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="8"
                            Visibility="Collapsed">
                    <TextBlock Text="Ask a coding question to get started"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Message list -->
                <ScrollViewer x:Name="MessagesScrollViewer"
                              Grid.Row="1"
                              Visibility="Collapsed">
                    <ItemsControl x:Name="MessagesItemsControl" Margin="16,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:ChatMessageControl Message="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="16" x:Name="InputBar" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="MessageInputBox"
                             Grid.Column="0"
                             PlaceholderText="Ask a coding question..."
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="44"
                             TextChanged="MessageInputBox_TextChanged">
                        <TextBox.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Enter"
                                                  Modifiers="None"
                                                  Invoked="EnterAccelerator_Invoked" />
                        </TextBox.KeyboardAccelerators>
                    </TextBox>

                    <Button x:Name="SendButton"
                            Grid.Column="1"
                            Content="Send"
                            Margin="8,0,0,0"
                            VerticalAlignment="Bottom"
                            Click="SendButton_Click" />

                    <Button x:Name="StopButton"
                            Grid.Column="1"
                            Content="Stop"
                            Margin="8,0,0,0"
                            VerticalAlignment="Bottom"
                            Visibility="Collapsed"
                            Click="StopButton_Click" />
                </Grid>

                <TextBlock x:Name="ErrorTextBlock"
                           Grid.Row="1"
                           VerticalAlignment="Bottom"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</Window>
