<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Rogarion.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: chat history -->
        <Grid Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="History"
                       Margin="16,16,16,8"
                       Style="{ThemeResource SubtitleTextBlockStyle}" />

            <ListView x:Name="SessionListView" Grid.Row="1" Margin="8,0,8,8">
                <!-- Populated in Milestone 6/7 -->
            </ListView>
        </Grid>

        <!-- Main chat pane -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="8">
                <TextBlock Text="Ask a coding question to get started"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="16">
                <TextBox x:Name="MessageInputBox"
                         PlaceholderText="Ask a coding question..."
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="44" />
            </Grid>
        </Grid>
    </Grid>
</Window>
