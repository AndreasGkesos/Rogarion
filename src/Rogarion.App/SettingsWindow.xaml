<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Rogarion.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Rogarion.App.Converters">

    <Grid>
        <Grid.Resources>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar (draggable region for ExtendsContentIntoTitleBar) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0">
            <TextBlock Text="Settings"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"
                       Opacity="0.8" />
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="24">
            <StackPanel Spacing="16" MaxWidth="560" HorizontalAlignment="Left">

                <TextBlock Text="Preset Modes" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="Modes adjust the system prompt sent with your message. Built-in modes can't be edited or deleted, but you can duplicate one to make your own."
                           TextWrapping="Wrap"
                           Opacity="0.7"
                           Style="{ThemeResource BodyTextBlockStyle}" />

                <ItemsControl x:Name="ModesItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8"
                                    Padding="12"
                                    CornerRadius="6"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    CornerRadius="4"
                                                    Padding="6,1"
                                                    Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="Built-in" FontSize="11" Opacity="0.7" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                            <Button Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="6"
                                                    Click="DuplicateModeButton_Click"
                                                    Tag="{Binding}"
                                                    ToolTipService.ToolTip="Duplicate">
                                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                            </Button>
                                            <Button Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="6"
                                                    Click="DeleteModeButton_Click"
                                                    Tag="{Binding}"
                                                    Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                                                    ToolTipService.ToolTip="Delete">
                                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding SystemPrompt}"
                                               TextWrapping="Wrap"
                                               Opacity="0.8"
                                               Style="{ThemeResource CaptionTextBlockStyle}" />

                                    <!-- Inline delete confirmation, shown next to the item being deleted -->
                                    <Border x:Name="ItemDeleteConfirmPanel"
                                            Padding="10"
                                            CornerRadius="6"
                                            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                            Visibility="Collapsed">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{Binding Name}"
                                                       TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="Delete"
                                                        Tag="{Binding}"
                                                        Click="ConfirmDeleteButton_Click" />
                                                <Button Content="Cancel"
                                                        Tag="{Binding}"
                                                        Click="CancelDeleteButton_Click" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Padding="12"
                        CornerRadius="6"
                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="AddModeHeaderText" Text="Add a custom mode" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBox x:Name="NewModeNameBox" PlaceholderText="Name (e.g. Simplify)" />
                        <TextBox x:Name="NewModePromptBox"
                                 PlaceholderText="System prompt"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="70" />
                        <Button Content="Add Mode"
                                HorizontalAlignment="Left"
                                Click="AddModeButton_Click" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
