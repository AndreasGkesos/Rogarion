<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Rogarion.App.Controls.ChatMessageControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalContentAlignment="Stretch">

    <Grid>
        <Border x:Name="BubbleBorder"
                Margin="0,4"
                Padding="12,8"
                CornerRadius="6"
                MaxWidth="720">
            <StackPanel Spacing="4">
                <StackPanel x:Name="RoleRow" Orientation="Horizontal" Spacing="6">
                    <TextBlock x:Name="RoleTextBlock"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Opacity="0.7" />
                    <Border x:Name="ModeBadge"
                            CornerRadius="4"
                            Padding="6,1"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ModeBadgeText"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   FontSize="11" />
                    </Border>
                </StackPanel>
                <StackPanel x:Name="SegmentsPanel" Spacing="8" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
