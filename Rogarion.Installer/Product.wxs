<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!-- Product identity. Version: bump every release, keep in sync with Rogarion.App.csproj's
       <Version>. UpgradeCode: set once, NEVER change after the first real release — this is
       how Windows Installer recognizes a new MSI as an upgrade of this product rather than a
       separate app. -->
  <Package
    Name="Rogarion"
    Manufacturer="Andreas Gkesos"
    Version="1.0.0"
    UpgradeCode="69903e71-dd33-45a9-9560-b164f10b9513"
    Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Rogarion is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Install-time options, settable via the UI or command line (e.g. msiexec /i ... DELETE_USER_DATA=1). -->
    <Property Id="DELETE_USER_DATA" Value="0" Secure="yes" />
    <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" Secure="yes" />

    <!-- Where things get installed: Program Files\Rogarion\ -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Rogarion" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Rogarion" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <!-- File payload, auto-harvested from the staging folder build-installer.bat produces —
         no per-file GUIDs to manage by hand; WiX generates stable component IDs from the file
         list as long as the folder shape doesn't change unexpectedly. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="staging\App\**\*.*" />
    </ComponentGroup>

    <!-- Start Menu shortcut — always installed. Guid: set once, never change after shipping;
         changing it later makes Windows Installer treat it as a different component and can
         orphan the old shortcut on upgrade. -->
    <Component Id="StartMenuShortcut" Directory="ApplicationProgramsFolder" Guid="670706aa-a17d-400f-9fa3-aca4f670a40f">
      <Shortcut
        Id="StartMenuShortcutFile"
        Name="Rogarion"
        Target="[INSTALLFOLDER]Rogarion.exe"
        WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
      <RegistryValue
        Root="HKCU"
        Key="Software\Rogarion"
        Name="StartMenuShortcutInstalled"
        Type="integer"
        Value="1"
        KeyPath="yes" />
    </Component>

    <!-- Desktop shortcut — optional, controlled by INSTALLDESKTOPSHORTCUT (checked/on by
         default). Same GUID-stability rule as above. -->
    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="91877776-d45e-4722-a2db-e8ef3a301353" Condition="INSTALLDESKTOPSHORTCUT = &quot;1&quot;">
      <Shortcut
        Id="DesktopShortcutFile"
        Name="Rogarion"
        Target="[INSTALLFOLDER]Rogarion.exe"
        WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue
        Root="HKCU"
        Key="Software\Rogarion"
        Name="DesktopShortcutInstalled"
        Type="integer"
        Value="1"
        KeyPath="yes" />
    </Component>

    <!-- Deletes %LOCALAPPDATA%\Rogarion (rogarion.db and related files) on a true uninstall,
         only when the user opted in via DELETE_USER_DATA. Never fires on upgrade/repair.
         Same GUID-stability rule as the shortcuts above. -->
    <Component Id="DeleteUserData" Directory="INSTALLFOLDER" Guid="e6f2a4c8-3b7d-4a1e-9c5f-2d8b6a4e1f73" Condition="DELETE_USER_DATA = &quot;1&quot;">
      <util:RemoveFolderEx Id="RemoveUserDataFolder" Property="LOCALAPPDATADIR" On="uninstall" />
      <RegistryValue
        Root="HKCU"
        Key="Software\Rogarion"
        Name="DeleteUserDataRegistered"
        Type="integer"
        Value="1"
        KeyPath="yes" />
    </Component>

    <SetProperty Id="LOCALAPPDATADIR" Value="[LocalAppDataFolder]Rogarion" After="AppSearch" Sequence="both" />

    <!-- Ties everything above together into the one installable feature. -->
    <Feature Id="MainFeature" Title="Rogarion" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="DeleteUserData" />
    </Feature>

    <!-- Standard WiX install-directory-picker UI. -->
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

  </Package>
</Wix>
